<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
    <title><%= title %></title>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-2xl font-bold text-gray-800 mb-4">Upload a Text File</h1>
        <form action="/task/converts" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label for="textfile" class="block text-sm font-medium text-gray-700">Choose a text file:</label>
                <input
                    multiple
                    type="file"
                    name="textfile"
                    id="textfile"
                    class="mt-1 block w-full text-sm text-gray-500 border-gray-300 rounded-md shadow-sm
                     focus:ring-indigo-500 focus:border-indigo-500"
                    required
                >
            </div>
            <button
                type="submit"
                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-md 
                shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
               Export File
            </button>
        </form>
    </div>
</body>
</html>


